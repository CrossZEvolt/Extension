{
  "manifest_version": 3,
  "name": "CrossZ YouTube Enhancer",
  "description": "Ambient light, t\u0103ng \u00e2m l\u01b0\u1ee3ng \u0111\u1ebfn 500% v\u00e0 h\u1ed7 tr\u1ee3 ch\u1eb7n qu\u1ea3ng c\u00e1o YouTube.",
  "version": "0.0.0",
  "homepage_url": "https://github.com/CrossZEvolt/Extension",
  "author": "CrossZ contributors",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "128": "images/icon-128.png"
  },
  "minimum_chrome_version": "121",
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "24": "images/icon-24.png",
      "32": "images/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/live_chat*", "https://www.youtube.com/embed/*"],
      "js": ["scripts/ai-content.js"],
      "css": ["styles/ai.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/live_chat*"],
      "js": ["scripts/ads-content.js"],
      "css": ["styles/ads.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat?is_popout=1*"
      ],
      "css": [
        "styles/live-chat.css"
      ],
      "js": [
        "scripts/live-chat.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/content.css",
        "scripts/content-main.js",
        "scripts/injected.js",
        "models/fsrcnn-small-x2.json",
        "models/fsrcnn-small-x3.json",
        "images/noise-1.png",
        "images/noise-2.png",
        "images/noise-3.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "scripting",
    "storage",
    "tabCapture",
    "offscreen",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": ["https://www.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ads",
        "enabled": true,
        "path": "rules/youtube-ads.json"
      }
    ]
  }
}
