{
  "name": "crossz-youtube-enhancer",
  "version": "0.2.0",
  "description": "This browser extension adds ambient light to the videos you view on YouTube",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrossZEvolt/Extension.git"
  },
  "author": "CrossZ contributors; Ambient engine by Wessel Kroos",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:manifest": "node manifest-copy.js",
    "build:html": "copyfiles -u 1 src/*.html dist",
    "build:images": "copyfiles -u 2 src/images/* dist/images",
    "build:styles:content": "sass --no-source-map src/styles/content.scss dist/styles/content.css",
    "build:styles:live-chat": "sass --no-source-map src/styles/live-chat.scss dist/styles/live-chat.css",
    "build:styles:options": "copyfiles -u 2 src/styles/options.css dist/styles",
    "build:styles": "run-p build:styles:content build:styles:live-chat build:styles:options build:styles:popup build:styles:ads build:styles:ai",
    "build:styles:ai": "copyfiles -u 2 src/styles/ai.css dist/styles",
    "build:styles:ads": "copyfiles -u 2 src/styles/ads.css dist/styles",
    "build:scripts:rollup": "rollup -c",
    "build:scripts": "rollup -c",
    "build": "run-s build:scripts build:styles build:manifest build:html build:images build:notices build:rules build:models",
    "build:models": "copyfiles -u 1 src/models/* dist",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js",
    "test": "npm run test:unit && npm run test:browser",
    "verify:build": "node tools/verify-build.js",
    "build:notices": "copyfiles LICENSE THIRD_PARTY_NOTICES.md dist",
    "build:rules": "copyfiles -u 1 src/rules/*.json dist",
    "build:styles:popup": "copyfiles -u 2 src/styles/popup.css dist/styles",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "npm run build && npm run verify:build && node tools/package.js"
  },
  "engines": {
    "node": "22.5.1"
  },
  "volta": {
    "node": "22.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "babel-plugin-transform-replace-expressions": "^0.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "replace-in-file": "^8.3.0",
    "rollup": "^4.42.0",
    "sass": "^1.62.1",
    "playwright": "1.57.0"
  },
  "overrides": {
    "@rollup/plugin-eslint": {
      "eslint": "$eslint"
    }
  },
  "private": true
}
